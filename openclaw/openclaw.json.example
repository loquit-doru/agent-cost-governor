{
  // ProceedGate OpenClaw configuration example
  // Copy to ~/.openclaw/openclaw.json and fill in your values

  "agent": {
    "model": "anthropic/claude-opus-4-6",
    "workspace": "./openclaw"
  },

  "skills": {
    "entries": {
      "onchain-cost-governor": {
        "enabled": true,
        "env": {
          "GOVERNOR_API_URL": "https://governor.proceedgate.dev"
        }
      }
    },
    "load": {
      "extraDirs": ["./skills"],
      "watch": true
    }
  }
}
