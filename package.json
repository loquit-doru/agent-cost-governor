{
  "name": "agent-cost-governor",
  "private": true,
  "workspaces": [
    "worker",
    "runner",
    "sdk-node",
    "mcp-server",
    "sdk/langchain"
  ],
  "devDependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "concurrently": "^9.1.2",
    "ethers": "^6.16.0",
    "openai": "^6.16.0",
    "solc": "^0.8.33",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "dev:worker": "npm --workspace worker run dev",
    "dev:worker:8787": "npm --workspace worker run dev -- --port 8787",
    "build": "npm --workspaces run build",
    "check": "npm --workspaces run check",
    "test": "npm --workspace worker run test",
    "test:watch": "npm --workspace worker run test:watch",
    "test:coverage": "npm --workspace worker run test:coverage",
    "deploy:site": "npx wrangler pages deploy site --project-name proceedgate --branch main",
    "demo:sdk": "npm run build && node examples/sdk-demo.mjs",
    "demo:billing": "node scripts/demo-billing.mjs",
    "demo:hackathon:proof": "node scripts/hackathon-proof.mjs",
    "wallet:generate:testnet": "node scripts/generate-deploy-wallet.mjs",
    "deploy:contract:testnet": "node scripts/deploy-cost-governor-testnet.mjs",
    "demo:storm:block": "npm run build && node scripts/run-storm-demo.mjs block",
    "demo:storm:redeem": "npm run build && node scripts/run-storm-demo.mjs redeem",
    "demo:agent": "npm run build && node scripts/demo-agent.mjs",
    "demo:llm-gateway": "npm run build && node scripts/demo-llm-gateway.mjs",
    "demo:defi-bot": "npm run build && node scripts/demo-defi-bot.mjs",
    "demo:multi-agent": "npm run build && node scripts/demo-multi-agent.mjs",
    "demo:video": "npm run build && node scripts/demo-video.mjs",
    "smoke": "npm run build && node scripts/run-storm-demo.mjs smoke",
    "deploy:worker": "npm --workspace worker run deploy",
    "tail:worker": "cd worker && npx wrangler tail",
    "tail:prod": "cd worker && npx wrangler tail --env prod"
  }
}
